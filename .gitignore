.claude/worktrees/**
.claude/settings.local.json

# --- Rust ---------------------------------------------------------------
# Cargo.lock is committed on purpose (workspace ships binaries).
/target/
**/target/
**/*.rs.bk
*.pdb

# Coverage and profiling
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
cobertura.xml
/coverage/

# proptest-regressions/ is committed on purpose (failing cases replay in CI).

# --- Tauri app (app/) ---------------------------------------------------
/app/src-tauri/target/
/app/src-tauri/gen/schemas/
/app/node_modules/
/app/dist/
/app/.vite/
/app/.svelte-kit/
/app/.next/

# --- Node (front-end tooling, docs checks) ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Markoo -------------------------------------------------------------
# Atomic-write temp files left behind by an interrupted sync
*.markoo-tmp
# Local data dir used while developing (MARKOO_DATA_DIR)
/.markoo-dev/
# Personal config for manual testing; markoo.example.toml stays versioned
markoo.local.toml
# NB: never ignore .obsidian/ globally — test fixtures contain Obsidian vaults.

# --- Secrets ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs ---------------------------------------------------------------
*.log
logs/

# --- Editors ------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.fleet/
.zed/

# --- OS -----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
